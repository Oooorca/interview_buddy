{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interview Buddy",
  "version": "0.2.0",
  "identifier": "com.oooorca.interview-buddy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Interview Buddy",
        "width": 880,
        "height": 540,
        "minWidth": 680,
        "minHeight": 340,
        "center": true,
        "visible": true,
        "alwaysOnTop": true,
        "contentProtected": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true
  }
}
